+sub derived_pmu_affinity_cpuset {
+    my ($conf) = @_;
+
+    # Windows on ARM calibrates its timers from the PMU cycle counter. On a host with more than one
+    # CPU PMU (big.LITTLE), KVM freezes that counter whenever a vCPU is scheduled onto the other
+    # cluster, and the Windows boot manager then traps on a divide-by-zero. Pin such guests to a
+    # single PMU cluster. An explicit 'affinity' always wins. This is applied to the VM's systemd
+    # scope (AllowedCPUs), not via a taskset(1) command prefix: a prefixed command inherits the
+    # tainted cpu-list and fails under the pvedaemon worker's taint mode ('perl -T').
+    return if $conf->{affinity};
+    my $arch = PVE::QemuServer::Helpers::get_vm_arch($conf);
+    return if $arch ne 'aarch64' || !is_native_arch($arch);
+    return if !windows_version($conf->{ostype});
+    return PVE::QemuServer::Helpers::heterogeneous_pmu_cpuset();
+}
