 }
 
+my $pmu_sysfs_dir = '/sys/bus/event_source/devices';
+
+=head3 heterogeneous_pmu_cpuset
+
+    my $cpuset = heterogeneous_pmu_cpuset();
+
+On aarch64 hosts with more than one kind of CPU core (e.g. big.LITTLE), each core type comes with
+its own PMU. KVM binds a guest's PMU to the PMU of the core the VM happened to be created on, and a
+vCPU that is later scheduled onto a core of the other type sees a cycle counter that does not
+advance. Windows relies on that cycle counter to calibrate its timers at boot and traps on a
+resulting divide-by-zero in the boot manager, so such guests need to be pinned to the cores of a
+single PMU. Returns the (untainted) cpu-list of the PMU covering the most cores if the host exposes
+more than one CPU PMU, C<undef> otherwise (including on hosts without the sysfs interface).
+
+=cut
+
+sub heterogeneous_pmu_cpuset {
+    my @pmus;
+    for my $cpus_file (glob("$pmu_sysfs_dir/*/cpus")) {
+        my ($name) = $cpus_file =~ m!/([^/]+)/cpus$!;
+        # only CPU PMUs, skip software/breakpoint/uncore (arm_smmuv3_pmcg, arm_dsu, ...) ones
+        next if $name !~ /^armv\d+_/;
+        my $cpus = eval { PVE::Tools::file_read_firstline($cpus_file) } // next;
+        $cpus =~ s/\s+//g;
+        next if $cpus eq '';
+        my $count = 0;
+        for my $range (split(/,/, $cpus)) {
+            my ($start, $end) = split(/-/, $range);
+            $count += defined($end) ? $end - $start + 1 : 1;
+        }
+        push @pmus, { name => $name, cpus => $cpus, count => $count };
+    }
+    return if scalar(@pmus) < 2;
+
+    my ($largest) = sort { $b->{count} <=> $a->{count} || $a->{name} cmp $b->{name} } @pmus;
+    # untaint: the value came from sysfs, and pvedaemon runs under taint mode ('perl -T'), so it
+    # must be laundered before it can reach exec (e.g. systemctl set-property)
+    my ($cpus) = $largest->{cpus} =~ /^([0-9,\-]+)$/
+        or return;
+    return $cpus;
+}
