diff --git a/src/PVE/QemuServer/Cfg2Cmd/Timer.pm b/src/PVE/QemuServer/Cfg2Cmd/Timer.pm
index d03715a0..f5af2ed5 100644
--- a/src/PVE/QemuServer/Cfg2Cmd/Timer.pm
+++ b/src/PVE/QemuServer/Cfg2Cmd/Timer.pm
@@ -18,14 +18,18 @@ sub generate {
         $time_drift_fix = 1 if $acpi && !defined($time_drift_fix);
     }
 
+    # the i8254 PIT and the RTC driftfix are x86 only; the aarch64 'virt' machine has a PL031 RTC
+    # and no PIT, so QEMU would only warn about (or ignore) these flags
+    my $is_x86 = $cfg2cmd->arch() eq 'x86_64';
+
     if ($cfg2cmd->windows_version() >= 6) {
-        $cfg2cmd->add_global_flag('kvm-pit.lost_tick_policy=discard');
+        $cfg2cmd->add_global_flag('kvm-pit.lost_tick_policy=discard') if $is_x86;
         $cfg2cmd->add_machine_flag_if_supported('hpet', 'off');
     } elsif ($cfg2cmd->is_linux() && $cfg2cmd->version_guard(10, 1, 0)) {
         $cfg2cmd->add_machine_flag_if_supported('hpet', 'off');
     }
 
-    $cfg2cmd->add_rtc_flag('driftfix=slew') if $time_drift_fix;
+    $cfg2cmd->add_rtc_flag('driftfix=slew') if $time_drift_fix && $is_x86;
 
     if ($startdate ne 'now') {
         $cfg2cmd->add_rtc_flag("base=$startdate");
