   include(CheckCCompilerFlag)
diff --git a/ceph/debian/rules b/ceph/debian/rules
index 442ea28d4..4da37b8c2 100755
--- a/ceph/debian/rules
+++ b/ceph/debian/rules
@@ -36,6 +36,15 @@ else
   extraopts += -DWITH_RBD_RWL=OFF
 endif
 extraopts += -DWITH_RBD_SSD_CACHE=ON
+extraopts += -DWITH_BLUESTORE=ON
+extraopts += -DWITH_LIBURING=ON
+ifeq ($(DEB_HOST_ARCH), arm64)
+  extraopts += -DWITH_SPDK=ON
+else ifeq ($(DEB_HOST_ARCH), amd64)
+  extraopts += -DWITH_SPDK=ON
+else
+  extraopts += -DWITH_SPDK=OFF
+endif
 # assumes that ceph is exmpt from multiarch support, so we override the libdir.
 extraopts += -DCMAKE_INSTALL_LIBDIR=/usr/lib
 extraopts += -DCMAKE_INSTALL_LIBEXECDIR=/usr/libexec
