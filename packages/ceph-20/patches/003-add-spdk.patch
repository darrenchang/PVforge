diff --git a/ceph/cmake/modules/BuildSPDK.cmake b/ceph/cmake/modules/BuildSPDK.cmake
index d6ce97e1d..c23cdcdc3 100644
--- a/ceph/cmake/modules/BuildSPDK.cmake
+++ b/ceph/cmake/modules/BuildSPDK.cmake
@@ -11,6 +11,10 @@ macro(build_spdk)
   endif()
   include(FindMake)
   find_make("MAKE_EXECUTABLE" "make_cmd")
+  # Fix: Replace $(MAKE) with actual make executable to avoid shell expansion issues
+  if(make_cmd STREQUAL "$(MAKE)")
