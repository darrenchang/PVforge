RUN bash -c "./packages/build.sh --package ${PACKAGE}";
RUN bash -c "./packages/install.sh --package ${PACKAGE}";

# proxmox-ve is a metapackage; its install needs proxmox-default-kernel,
# which is not built by this repo, so only build it.
# ENV PACKAGE=proxmox-ve
# COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
# RUN bash -c "./packages/build.sh --package ${PACKAGE}";
# RUN bash -c "./packages/install.sh --package ${PACKAGE}";

# =============================================================================
# Bootstrap: pve-cluster <-> pve-access-control build-dependency cycle.
#
# pve-cluster Build-Depends on libpve-access-control only because manpage
# generation loads PVE::RPCEnvironment (shipped by pve-access-control) and the
# test suite uses PVE::AccessControl (tests are skipped, common.sh builds with
# nocheck). pve-access-control in turn needs libpve-cluster-perl + pve-cluster
# to build. Stage 1 builds pve-cluster with that build-dep stripped and a stub
# PVE::RPCEnvironment; stage 2 builds pve-access-control normally.
# =============================================================================
ENV PACKAGE=pve-cluster
RUN apt update; \
    apt install -y \
    libdigest-hmac-perl \
    librrds-perl \
    rrdcached \
    sqlite3;
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN mkdir -p /usr/share/perl5/PVE && \
    printf 'package PVE::RPCEnvironment;\nuse strict;\nuse warnings;\nuse base "PVE::RESTEnvironment";\nour $AUTOLOAD;\nsub AUTOLOAD { return; }\n1;\n' \
      > /usr/share/perl5/PVE/RPCEnvironment.pm && \
    sed -i '/^Build-Depends/,/^[A-Z][A-Za-z-]*:/{/libpve-access-control/d}' \
      ./packages/${PACKAGE}/${PACKAGE}/debian/control && \
    bash -c "./packages/build.sh --package ${PACKAGE}" && \
    rm -f /usr/share/perl5/PVE/RPCEnvironment.pm
# libpve-cluster-api-perl runtime-depends on libpve-access-control, which does
# not exist yet -- defer it (force-installing would leave apt in a broken
# state and fail every later mk-build-deps run).
RUN bash -c 'apt install -y --allow-downgrades -o Dpkg::Options::="--force-confnew" $(ls /deb/proxmox/${PACKAGE}/*.deb | grep -v -- "-dbgsym_\|api-perl")';

ENV PACKAGE=pve-access-control
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN apt update; \
    apt install -y \
    libauthen-pam-perl \
    libuuid-perl;
RUN bash -c "./packages/build.sh --package ${PACKAGE}";
RUN bash -c "./packages/install.sh --package ${PACKAGE}";
# now the deferred libpve-cluster-api-perl is cleanly installable
RUN apt install -y --allow-downgrades /deb/proxmox/pve-cluster/libpve-cluster-api-perl_*.deb;

# already built further up; runtime-depends on libpve-access-control
ENV PACKAGE=librados2-perl
RUN bash -c "./packages/install.sh --package ${PACKAGE}";

# pve-firewall runtime-depends on libpve-network-perl, while pve-network
# build-depends on pve-firewall — but nothing in pve-network actually uses
# PVE::Firewall, so that build-dep is stripped and pve-network is built first.
ENV PACKAGE=pve-network
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN apt update; \
    apt install -y \
    libnet-subnet-perl \
    libtest-differences-perl;
RUN sed -i '/^Build-Depends/,/^[A-Z][A-Za-z-]*:/{/pve-firewall/d}' \
      ./packages/${PACKAGE}/${PACKAGE}/debian/control && \
    bash -c "./packages/build.sh --package ${PACKAGE}";
# libpve-network-api-perl runtime-depends on pve-firewall, which does not
# exist yet -- defer it (same pattern as libpve-cluster-api-perl above)
RUN bash -c 'apt install -y --allow-downgrades -o Dpkg::Options::="--force-confnew" $(ls /deb/proxmox/${PACKAGE}/*.deb | grep -v -- "-dbgsym_\|api-perl")';

ENV PACKAGE=pve-firewall
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN apt update; \
    apt install -y \
    libnetfilter-conntrack-dev \
    libnetfilter-log-dev;
RUN bash -c "./packages/build.sh --package ${PACKAGE}";
RUN bash -c "./packages/install.sh --package ${PACKAGE}";
# now the deferred libpve-network-api-perl is cleanly installable
RUN apt install -y --allow-downgrades /deb/proxmox/pve-network/libpve-network-api-perl_*.deb;

ENV PACKAGE=pve-storage
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build.sh --package ${PACKAGE}";
# libpve-storage-perl depends on proxmox-backup-client and
# proxmox-backup-file-restore, whose install was deferred at the
# proxmox-backup step above (client-static conflicts with client).
RUN bash -c 'apt install -y --allow-downgrades -o Dpkg::Options::="--force-confnew" /deb/proxmox/proxmox-backup/proxmox-backup-client_*.deb /deb/proxmox/proxmox-backup/proxmox-backup-file-restore_*.deb';
RUN bash -c "./packages/install.sh --package ${PACKAGE}";

ENV PACKAGE=pve-guest-common
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build.sh --package ${PACKAGE}";
RUN bash -c "./packages/install.sh --package ${PACKAGE}";

# =============================================================================
# pve-container / pve-ha-manager / qemu-server runtime-depend on each other,
# so they are built first and then installed in ONE apt transaction.
# qemu-server's build-dep on pve-ha-manager is test-only (<!nocheck>) and is
# dropped to break the build-order cycle.
# =============================================================================
ENV PACKAGE=pve-container
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build.sh --package ${PACKAGE}";

ENV PACKAGE=pve-ha-manager
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build.sh --package ${PACKAGE}";

# qemu-server build-depends on pve-edk2-firmware-ovmf
ENV PACKAGE=pve-edk2-firmware
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN apt update; \
    apt install -y \
    acpica-tools \
    gcc-x86-64-linux-gnu \
    gcc-multilib-x86-64-linux-gnu \
    binutils-x86-64-linux-gnu \
    gcc-riscv64-linux-gnu \
    nasm \
    python3-virt-firmware \
    python3-pexpect \
    xorriso \
    dosfstools \
    mtools \
    bc;
# arm64: the x86 firmware images are cross-compiled; upstream rules only set
# toolchain prefixes for a build host that is amd64. edk2's tools_def reads
# the X64 and IA32 prefixes from the single GCC5_BIN env var (not from
# GCC5_X64_PREFIX/GCC5_IA32_PREFIX), and the IA32 units compile with -m32,
# hence the multilib cross-gcc.
RUN sed -i \
    -e '/AARCH64_PREFIX=aarch64-linux-gnu-/a export GCC5_BIN=x86_64-linux-gnu-' \
    ./packages/${PACKAGE}/${PACKAGE}/debian/rules;
RUN bash -c "./packages/build.sh --package ${PACKAGE}";
RUN bash -c "./packages/install.sh --package ${PACKAGE}";

ENV PACKAGE=qemu-server
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
# DEBUG probe (temporary): show the clean single-process Vnets.pm load error
RUN bash -c "./packages/build.sh --package ${PACKAGE}";

# install the runtime-dependency triangle in one transaction
RUN bash -c 'apt install -y --allow-downgrades -o Dpkg::Options::="--force-confnew" $(ls /deb/proxmox/pve-container/*.deb /deb/proxmox/pve-ha-manager/*.deb /deb/proxmox/qemu-server/*.deb | grep -v -- "-dbgsym_\|-test_")';

ENV PACKAGE=proxmox-firewall
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build.sh --package ${PACKAGE}";
RUN bash -c "./packages/install.sh --package ${PACKAGE}";

# =============================================================================
# yew GUI stack: extra rust libs (debcargo-conf-extra) + pwt/pwt-macros
# (proxmox-yew-widget-toolkit) + proxmox-yew-comp + proxmox-wasm-builder are
# build dependencies of pve-yew-mobile-gui. The extra rust libs are built
# from a fresh copy of the debcargo-conf tree so the main (expensive)
# debcargo-conf layer stays untouched.
# =============================================================================
ENV PACKAGE=debcargo-conf-extra
COPY ./packages/debcargo-conf/ ./packages/debcargo-conf/
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build.sh --package ${PACKAGE}";

ENV PACKAGE=proxmox-yew-widget-toolkit
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build.sh --package ${PACKAGE}";
RUN bash -c "./packages/install.sh --package ${PACKAGE}";

ENV PACKAGE=proxmox-yew-comp
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build.sh --package ${PACKAGE}";
RUN bash -c "./packages/install.sh --package ${PACKAGE}";

ENV PACKAGE=proxmox-wasm-builder
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build.sh --package ${PACKAGE}";
RUN bash -c "./packages/install.sh --package ${PACKAGE}";

ENV PACKAGE=pve-yew-mobile-gui
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
# the /usr/local rust toolchain only ships the host std; the yew GUIs are
# compiled for wasm32-unknown-unknown via proxmox-wasm-builder
RUN curl -L "https://static.rust-lang.org/dist/rust-std-1.94.0-wasm32-unknown-unknown.tar.xz" -o rust-std-wasm32.tar.xz && \
    mkdir -p ./rust-std-wasm32/ && \
    tar -xf rust-std-wasm32.tar.xz -C ./rust-std-wasm32/ --strip-components=1 && \
    /bin/bash -c "./rust-std-wasm32/install.sh" && \
    rm -fr rust-std-wasm32*;
RUN bash -c "./packages/build.sh --package ${PACKAGE}";
RUN bash -c "./packages/install.sh --package ${PACKAGE}";

ENV PACKAGE=proxmox-enterprise-support
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build.sh --package ${PACKAGE}";
RUN bash -c "./packages/install.sh --package ${PACKAGE}";

ENV PACKAGE=pve-manager
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN apt update; \
    apt install -y \
    libfile-readbackwards-perl \
    libtemplate-perl \
    dtach;
RUN bash -c "./packages/build.sh --package ${PACKAGE}";
# pve-manager runtime-depends on pve-yew-mobile-gui and
# proxmox-enterprise-support-keyring, both built above.
RUN bash -c "./packages/install.sh --package ${PACKAGE}";

