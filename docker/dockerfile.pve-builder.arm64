ARG BASE_IMAGE="pve-builder"
FROM ${BASE_IMAGE}
ARG DEBIAN_FRONTEND=noninteractive

RUN apt update;

WORKDIR /workspace/

COPY ./packages/build.sh ./packages/
COPY ./packages/install.sh ./packages/
COPY ./docker/start.sh ./packages/
COPY ./packages/common.sh ./packages/
COPY ./.git/ ./.git/

ENV PACKAGE=musl
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build.sh --package ${PACKAGE}";
RUN bash -c "./packages/install.sh --package ${PACKAGE}";

ENV PATH=/usr/local/musl-cross/bin:${PATH}

ENV PACKAGE=debcargo-conf
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build.sh --package ${PACKAGE}";
RUN bash -c "./packages/install.sh --package ${PACKAGE}";

