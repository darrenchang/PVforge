RUN bash -c "./packages/build_all.sh --package ${PACKAGE}";

ENV PACKAGE=ceph-20
RUN apt update && \
    apt install -y \
    libsqlite3-mod-ceph-dev \
    libsqlite3-dev;
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build_all.sh --package ${PACKAGE}";

ENV PACKAGE=proxmox-perltidy
RUN apt update && \
    apt install -y \
    perltidy;
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build_all.sh --package ${PACKAGE}";

ENV PACKAGE=perlmod
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
