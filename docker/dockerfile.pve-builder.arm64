RUN bash -c "./packages/build_all.sh --package ${PACKAGE}";

ENV PACKAGE=frr
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build_all.sh --package ${PACKAGE}";

ENV PACKAGE=ifupdown2
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build_all.sh --package ${PACKAGE}";

ENV PACKAGE=kronosnet
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build_all.sh --package ${PACKAGE}";

ENV PACKAGE=ksm-control-daemon
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build_all.sh --package ${PACKAGE}";

ENV PACKAGE=libarchive-perl
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build_all.sh --package ${PACKAGE}";

ENV PACKAGE=libjs-qrcodejs
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build_all.sh --package ${PACKAGE}";

ENV PACKAGE=libpve-u2f-server-perl
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build_all.sh --package ${PACKAGE}";

ENV PACKAGE=libqb
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build_all.sh --package ${PACKAGE}";

ENV PACKAGE=libseccomp
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build_all.sh --package ${PACKAGE}";

ENV PACKAGE=libtpms
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build_all.sh --package ${PACKAGE}";

ENV PACKAGE=libxdgmime-perl
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build_all.sh --package ${PACKAGE}";

ENV PACKAGE=lxc
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
# Fix git issues
RUN ( \
      cd ./packages/$PACKAGE/$PACKAGE/ && \
      rm -rf .git lxc/ .gitmodules && \
      git init && \
      git config --global --add safe.directory /workspace/packages/lxc/lxc && \
      git submodule add https://git.proxmox.com/git/mirror_lxc ./lxc; \
    )
RUN bash -c "./packages/build_all.sh --package ${PACKAGE}";

ENV PACKAGE=lxcfs
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build_all.sh --package ${PACKAGE}";

ENV PACKAGE=novnc-pve
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build_all.sh --package ${PACKAGE}";

ENV PACKAGE=pathpatterns
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build_all.sh --package ${PACKAGE}";

ENV PACKAGE=pixman
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build_all.sh --package ${PACKAGE}";

ENV PACKAGE=vncterm
