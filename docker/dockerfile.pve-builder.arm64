RUN bash -c "./packages/build.sh --package ${PACKAGE}";
RUN bash -c "./packages/install.sh --package ${PACKAGE} --force-install true";

ENV PACKAGE=proxmox-acme
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build.sh --package ${PACKAGE}";
RUN bash -c "./packages/install.sh --package ${PACKAGE} --force-install true";

ENV PACKAGE=proxmox-fuse-rs
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
