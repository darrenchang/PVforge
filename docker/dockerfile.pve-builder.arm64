# transaction (the keyring note that used to be here was wrong -- only
# pve-manager needs proxmox-enterprise-support-keyring). The client and
# file-restore debs that libpve-storage-perl depends on are installed
# right before pve-storage below.
# RUN bash -c "./packages/install.sh --package ${PACKAGE}";

ENV PACKAGE=proxmox-backup-meta
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN bash -c "./packages/build.sh --package ${PACKAGE}";
# RUN bash -c "./packages/install.sh --package ${PACKAGE}";

ENV PACKAGE=proxmox-backup-qemu
COPY ./packages/${PACKAGE}/ ./packages/${PACKAGE}/
RUN apt update; \
